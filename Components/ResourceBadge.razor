@using MudBlazor
@using BlazorApp1.Models
@using BlazorApp1.Services
@inject ResourceService ResourceService


<MudTooltip Text="@TooltipText" Placement="Placement.Top" Arrow="true">
    <div class="resource-badge">
        <img src="@ImagePath" 
             alt="@TooltipText" 
             class="resource-icon" 
             onerror="this.style.display='none'; this.nextElementSibling.style.display='inline';" />
        <!-- Repli textuel si l'image n'est pas trouvée -->
        <span class="resource-fallback" style="display:none;">@FallbackName</span>
    </div>
</MudTooltip>


<style>
    .resource-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;  /* Augmenté (ex: de 26px à 36px) */
        height: 36px; /* Augmenté (ex: de 26px à 36px) */
        border-radius: 4px;
        background: #1e1e1e;
        border: 1px solid #444;
        padding: 2px;
        cursor: pointer;
    }

        .resource-badge:hover {
            border-color: #3b82f6;
        }

    .resource-icon {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .resource-fallback {
        font-size: 0.65rem;
        color: #ddd;
        text-transform: uppercase;
    }
</style>

@code {
    [Parameter, EditorRequired] public string ResourceId { get; set; } = string.Empty;

    // Récupération de la ressource dans le service
    private Resource? Res => ResourceService.Get(ResourceId);

    // 1. Image : utilise le chemin exact défini dans le JSON, ou repli par défaut
    private string ImagePath =>
        !string.IsNullOrWhiteSpace(Res?.Image) 
            ? Res.Image 
            : $"images/resources/{ResourceId}.png";

    // 2. Nom : utilise le vrai nom du JSON (ex: "Acid", "Iron Ore")
    private string TooltipText =>
        Res?.Name ?? System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(ResourceId.Replace("_", " "));

    // 3. Trois premières lettres pour le secours
    private string FallbackName =>
        (Res?.Name ?? ResourceId).Substring(0, Math.Min(3, (Res?.Name ?? ResourceId).Length));

}